{
  "format": "esl-layouts",
  "version": 1,
  "model": "1.54",
  "description": "Example layouts for the SoluM 1.54\" (200 x 200). Upload with PUT /api/layouts/1.54.",
  "layouts": [
    {
      "name": "shelf",
      "description": "Name in a black band, highlighted price, a note and the unit price",
      "fields": ["name", "price", "unit", "info"],
      "elements": [
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 36, "color": "black" },
        { "type": "text", "field": "name", "x": 4, "y": 0, "w": 192, "h": 36,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "field": "price", "x": 6, "y": 42, "w": 188, "h": 96,
          "fonts": ["large", "mid", "medium"], "align": "center", "valign": "middle", "lines": 1,
          "color": "highlight" },
        { "type": "text", "field": "info", "x": 6, "y": 142, "w": 188, "h": 34,
          "fonts": ["small"], "align": "center", "lines": 2 },
        { "type": "text", "field": "unit", "x": 6, "y": 180, "w": 188, "h": 17,
          "fonts": ["small"], "align": "center", "lines": 1 }
      ]
    },
    {
      "name": "sign",
      "description": "A heading over a rule, up to three centred lines, optional frame",
      "fields": ["title", "body"],
      "elements": [
        { "type": "text", "field": "title", "x": 8, "y": 8, "w": 184, "h": 30,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 1 },
        { "type": "rect", "x": 8, "y": 40, "w": 184, "h": 2 },
        { "type": "text", "field": "body", "x": 8, "y": 48, "w": 184, "h": 140,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 3 },
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 3, "color": "frame" },
        { "type": "rect", "x": 0, "y": 197, "w": 200, "h": 3, "color": "frame" },
        { "type": "rect", "x": 0, "y": 0, "w": 3, "h": 200, "color": "frame" },
        { "type": "rect", "x": 197, "y": 0, "w": 3, "h": 200, "color": "frame" }
      ]
    },
    {
      "name": "vare",
      "description": "Product label: brand in a black band, name, article number and EAN, price inc. VAT",
      "fields": ["brand", "name", "info", "price"],
      "_sample": ["Kramp", "Spann sort 12 l", "1626-160602/439 8713331002910", "17,25"],
      "elements": [
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 24, "color": "black" },
        { "type": "text", "field": "brand", "x": 6, "y": 0, "w": 188, "h": 24,
          "fonts": ["small"], "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "field": "name", "x": 5, "y": 28, "w": 190, "h": 52,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 2 },
        { "type": "text", "field": "info", "x": 5, "y": 84, "w": 190, "h": 38,
          "fonts": ["small"], "align": "center", "valign": "middle", "lines": 2 },
        { "type": "rect", "x": 0, "y": 126, "w": 200, "h": 2 },
        { "type": "text", "field": "price", "x": 5, "y": 132, "w": 190, "h": 64,
          "fonts": ["large", "mid", "medium"], "align": "right", "valign": "bottom", "lines": 1,
          "color": "highlight" }
      ]
    },
    {
      "name": "vare-mva",
      "description": "Product label with two prices: brand band, name, a small note (e.g. the price inc. VAT) and the highlighted price",
      "fields": ["brand", "name", "note", "price"],
      "_sample": ["Kramp", "Nedre kuleledd, kat. 3/2", "inkl. mva 192,25", "153,80"],
      "elements": [
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 24, "color": "black" },
        { "type": "text", "field": "brand", "x": 6, "y": 0, "w": 188, "h": 24,
          "fonts": ["small"], "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "field": "name", "x": 5, "y": 28, "w": 190, "h": 76,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 3 },
        { "type": "rect", "x": 0, "y": 108, "w": 200, "h": 2 },
        { "type": "text", "field": "note", "x": 5, "y": 114, "w": 190, "h": 18,
          "fonts": ["small"], "align": "right", "lines": 1 },
        { "type": "text", "field": "price", "x": 5, "y": 134, "w": 190, "h": 62,
          "fonts": ["large", "mid", "medium"], "align": "right", "valign": "bottom", "lines": 1,
          "color": "highlight" }
      ]
    },
    {
      "name": "vare-ean",
      "description": "Product label with an EAN-13 barcode: brand band, name, price, the code with its digits under it (1-pixel modules, 0.14 mm: check that your scanner reads it)",
      "fields": ["brand", "name", "ean", "price"],
      "_sample": ["Kramp", "Spann sort 12 l", "8713331002910", "17,25"],
      "elements": [
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 24, "color": "black" },
        { "type": "text", "field": "brand", "x": 6, "y": 0, "w": 110, "h": 24,
          "fonts": ["small"], "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "text": "inkl. mva", "x": 118, "y": 0, "w": 76, "h": 24,
          "fonts": ["small"], "align": "right", "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "field": "name", "x": 6, "y": 28, "w": 188, "h": 48,
          "fonts": ["medium", "small"], "lines": 2 },
        { "type": "text", "field": "price", "x": 6, "y": 76, "w": 188, "h": 56,
          "fonts": ["large", "mid", "medium"], "align": "right", "valign": "bottom", "lines": 1,
          "color": "highlight" },
        { "type": "barcode", "field": "ean", "symbology": "ean13",
          "x": 6, "y": 138, "w": 188, "h": 42, "align": "center" },
        { "type": "text", "field": "ean", "x": 6, "y": 181, "w": 188, "h": 17,
          "fonts": ["small"], "align": "center", "lines": 1 }
      ]
    },
    {
      "name": "vare-priser",
      "description": "Product label with the price both ex. and inc. VAT, both sent by the client: brand band, name, a note (e.g. the article number), price ex. VAT and the highlighted price inc. VAT",
      "fields": ["brand", "name", "info", "price", "price_ex"],
      "_sample": ["Kramp", "Nedre kuleledd, kat. 3/2", "1626-160602/439", "192,25", "153,80"],
      "elements": [
        { "type": "rect", "x": 0, "y": 0, "w": 200, "h": 24, "color": "black" },
        { "type": "text", "field": "brand", "x": 6, "y": 0, "w": 188, "h": 24,
          "fonts": ["small"], "valign": "middle", "lines": 1, "color": "white" },
        { "type": "text", "field": "name", "x": 5, "y": 28, "w": 190, "h": 50,
          "fonts": ["medium", "small"], "align": "center", "valign": "middle", "lines": 2 },
        { "type": "text", "field": "info", "x": 5, "y": 80, "w": 190, "h": 18,
          "fonts": ["small"], "align": "center", "lines": 1 },
        { "type": "rect", "x": 0, "y": 100, "w": 200, "h": 2 },
        { "type": "text", "text": "eks. mva", "x": 6, "y": 106, "w": 70, "h": 26,
          "fonts": ["small"], "valign": "middle", "lines": 1 },
        { "type": "text", "field": "price_ex", "x": 76, "y": 106, "w": 118, "h": 26,
          "fonts": ["medium", "small"], "align": "right", "valign": "middle", "lines": 1 },
        { "type": "text", "text": "inkl. mva", "x": 6, "y": 136, "w": 60, "h": 60,
          "fonts": ["small"], "valign": "bottom", "lines": 1 },
        { "type": "text", "field": "price", "x": 66, "y": 136, "w": 128, "h": 60,
          "fonts": ["large", "mid", "medium"], "align": "right", "valign": "bottom", "lines": 1,
          "color": "highlight" }
      ]
    }
  ]
}
