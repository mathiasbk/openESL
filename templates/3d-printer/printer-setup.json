          { "type": "rect", "x": 6, "y": 172, "w": 188, "h": 2 },
          { "type": "text", "field": "note", "x": 6, "y": 178, "w": 188, "h": 20, "fonts": ["small"], "align": "center", "valign": "middle", "lines": 1 }
