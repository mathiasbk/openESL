          { "type": "text", "field": "price", "x": 120, "y": 32, "w": 171, "h": 74, "fonts": ["large", "mid", "medium"], "align": "right", "valign": "bottom", "lines": 1, "color": "highlight" },
          { "type": "text", "field": "unit", "x": 5, "y": 108, "w": 286, "h": 17, "fonts": ["small"], "lines": 1 }
        ]
      }
    },
    "1.54": {
