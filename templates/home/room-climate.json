{
  "format": "esl-template",
  "version": 1,
  "id": "room-climate",
  "category": "home",
  "title": "Room climate",
  "description": "Room name, temperature in large digits, humidity and when it was updated, e.g. from Home Assistant sensors.",
  "tags": ["home", "home-assistant", "temperature", "sensor"],
  "docs": "docs/home-assistant.md",
  "fields": {
    "room": "Room name",
    "temp": "Temperature, digits only (e.g. 21,5)",
    "humidity": "Relative humidity in percent, digits only",
    "updated": "When the values were read, as text"
  },
  "variants": {
    "2.9": {
      "icons": {
        "drop": {"w": 16, "h": 22, "data": "AIABwAHAA+AD4AfwD/AP+D/8P/x//v///////////////3/+P/w//A/wB+A="}
      },
      "layout": {
        "name": "room-climate",
        "description": "Room name in the band, the temperature large, humidity to the right and the time at the bottom",
        "fields": ["room", "temp", "humidity", "updated"],
        "_sample": ["Living room", "21,5", "45", "Updated 14:05"],
        "elements": [
          { "type": "rect", "x": 0, "y": 0, "w": 296, "h": 28, "color": "black" },
