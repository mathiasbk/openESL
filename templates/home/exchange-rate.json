{
 "format": "esl-template",
 "version": 1,
 "id": "exchange-rate",
 "category": "home",
 "title": "Exchange rate",
 "description": "Today's exchange rate of a currency with its change since the day before, the highest and lowest of the last days and a chart of them. The AP's data sources fill it from Norges Bank (ESP32-S3 APs), or send the fields yourself.",
 "tags": [
  "home",
  "currency",
  "exchange rate",
  "valuta",
  "fx",
  "chart",
  "norges bank"
 ],
 "docs": "docs/data-sources.md",
 "fields": {
  "title": "The currency and what it is priced in (e.g. USD/NOK)",
  "value": "The rate (e.g. 9,5325)",
  "change": "The change since the day before (e.g. -0,0069 (-0,1 %))",
  "range": "The lowest and highest of the chart (e.g. 9,2278 - 9,6494)",
  "when": "The day of the rate (e.g. i går, or 12.11.)",
  "chart": "The rates for the chart: numbers apart by spaces, oldest first (e.g. 9.41 9.47 9.54)"
 },
