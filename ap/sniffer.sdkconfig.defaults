# The sniffer build: python build.py --sniffer <board> (its own build-<board>-sniffer folder),
# or idf.py -B build-sniffer -D SDKCONFIG=build-sniffer/sdkconfig -DSNIFFER=1 build: give it a
# folder and a sdkconfig of its own (idf.py keeps ap/sdkconfig otherwise), since a sdkconfig made
# with it stays a sniffer (docs/radio-sniffer.md). Read after the board's sdkconfig.defaults.
CONFIG_ESL_RADIO_SNIFFER=y
