CONFIG_IDF_TARGET="esp32c6"

# WiFi and 802.15.4 share the 2.4 GHz radio; coex stays at the driver's default
# (docs/ap-netradio.md, "Limits": a higher priority for 802.15.4 kills WiFi)
CONFIG_IEEE802154_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Log and set-up console (wifi, host, status) on the built-in USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A radio stuck in a busy loop restarts (the AP then sees its HELLO and tells it everything)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Fewer WiFi buffers than the default: the link is a few small exchanges, and RAM goes to
# the tag table, the images and the log
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_FREERTOS_HZ=1000
