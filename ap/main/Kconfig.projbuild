menu "OpenESL AP"

    config ESL_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            Used when NVS namespace "cfg" has no "ssid" key.

    config ESL_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            Used when NVS namespace "cfg" has no "pass" key.

    config ESL_WIFI_SETUP_AFTER_S
        int "Open the setup network after this many s without WiFi (0 = never)"
        range 0 3600
        default 180
        help
            With no network saved, the AP opens its own network
            "openesl-XXXX" at once, with a setup page at
            http://192.168.4.1/setup. With one saved that has not given an IP
            for this long, it opens the setup network too, and keeps trying
            the saved one. The setup network closes a minute after joining.

    config ESL_WIFI_SETUP_PASSWORD
        string "Setup network password (empty = open network)"
        default ""
        help
            8 to 63 characters for WPA2, empty for an open network. The page
            itself asks for the API token once a token is set, so an open
            setup network only lets strangers configure an AP that has none.

    config ESL_WIFI_CAPTIVE
        bool "Captive portal on the setup network"
        default y
        help
            While the setup network is open, a DNS server answers every name
            with 192.168.4.1 and unknown pages redirect to the setup form, so
            a phone that joins the network shows its "sign in" page with the
            form in it. Without it, open http://192.168.4.1/setup by hand.

    config ESL_API_TOKEN
        string "API bearer token"
        default ""
        help
            Clients send "Authorization: Bearer <token>". Used when NVS
            namespace "cfg" has no "token" key. If empty, every API request
            is rejected with 401.

    config ESL_MDNS_HOSTNAME
        string "mDNS hostname"
        default "openesl"

    config ESL_WEB_DASHBOARD
        bool "Dashboard at /dashboard (the web page's Dashboard tab, served by the AP)"
        default y
        help
            The web page's dashboard, packed into the firmware from web/ at
            build time (main/webui.py, about 23 KB gzipped), so a browser on
            the network can use it without the bridge: an https page may not
            call the AP's plain http API, a page from the AP itself may.
            Its API calls need the token as usual.

    config ESL_STATUS_PAGE
        bool "Status page at / (no token)"
        default y
        help
            A read-only HTML table of all tags (MAC, model, last seen,
            battery, content). It needs no token, so anyone on the network
            can read it. The /api/ endpoints always need the token.

    config ESL_SERIAL_API
        bool "API over the USB serial port"
        default y
        depends on ESP_CONSOLE_USB_SERIAL_JTAG
        help
            The same API as over HTTP, framed as "@ESL ..." lines on the
            built-in USB port next to the log (tools/esl-client --serial).
            Needs no token: whoever has the cable has the device.

    config ESL_CHANNEL
        int "802.15.4 channel"
        range 11 26
        default 25

    config ESL_PAN_ID
        hex "802.15.4 PAN ID"
        range 0x0000 0xFFFE
        default 0x4553

    config ESL_NEXT_POLL_S
        int "Default poll interval in s sent to tags (0 = tag keeps its own)"
        range 0 3600
        default 0
        help
            Built-in default for tags without their own poll_s. PUT /api/config
            overrides it at run time (stored in NVS cfg/poll_s), and
            PUT /api/tags/{mac}/config sets it per tag. Values other than 0
            should be 10..3600, the range the API accepts.

    config ESL_MAX_TAGS
        int "Max tags per AP"
        range 20 1000
        default 256
        help
            Size of the tag table. Each slot costs about 220 bytes of RAM for
            the whole run and up to about 320 bytes of NVS once the tag has
            content and settings (partitions.csv gives NVS 468 KB). The API
            replies that list every tag are streamed, so they do not grow
            with this. The boot log ends with the free heap; keep a good
            margin for WiFi and HTTP. See "How many tags" in README.md,
            also for what the radio takes.

    config ESL_MAX_SCHEDULED
        int "Max scheduled content entries"
        range 0 1000
        default 256
        help
            Room for content that takes effect at a given time ("at" in
            PUT /api/tags). Each entry costs 16 bytes of RAM and up to about
            160 bytes of NVS while it waits. 0 turns scheduling and the
            clock (/api/time, /api/schedule) off.

    config ESL_NTP_SERVER
        string "NTP server"
        default "pool.ntp.org"
        depends on ESL_MAX_SCHEDULED > 0
        help
            Where the AP gets the time once it is on WiFi. Empty: no NTP;
            the time then only comes from PUT /api/time.
    config ESL_WEBHOOK
        bool "Webhook: post the health report when it changes"
        default y
        help
            PUT /api/config {"webhook": "http://..."} makes the AP POST the
            report of GET /api/health (tags that are silent, never seen,
            failed to draw, low on battery, rejected the layout file, or
            cannot get their content) to that URL whenever any tag's
            problems change. Off: /api/config answers 422 for "webhook".

    config ESL_HEALTH_PERIOD_S
        int "Seconds between health checks for the webhook"
        depends on ESL_WEBHOOK
        range 5 3600
        default 30

    config ESL_OTA
        bool "OTA: new AP firmware through POST /api/ota"
        default y
        help
            The app image (build/esl_ap.bin, openesl-ap-ota.bin in a
            release) is written to the app slot that is not running, which
            becomes the boot slot; the AP restarts and the bootloader goes
            back to the old slot if the new image does not come up, or
            (with a WiFi network to join) gets neither a WiFi address nor
            an API request within three minutes.
            Needs the two-slot partition table (ap/partitions.csv) on a
            4 MB flash. Off: POST /api/ota answers 501.

    config ESL_TX_POWER_DBM
        int "802.15.4 TX power (dBm)"
        range -24 20
        default 10

    choice ESL_RADIO_MODE
        prompt "Radio mode"
        default ESL_RADIO_AP

        config ESL_RADIO_AP
            bool "AP: answer tag polls over 802.15.4"
        config ESL_RADIO_SNIFFER
            bool "Sniffer: log every frame on the channel, do not answer"
        config ESL_RADIO_STUB
            bool "Stub: no radio, simulated tags poll the store"
        config ESL_RADIO_UART
            bool "AP through a radio coprocessor on UART (an ESP32-C6 running ap/radio/)"
            help
                For a chip without 802.15.4 (the ESP32-S3 in boards/s3-n16r8-c6): a
                C6 running the firmware in ap/radio/ does the radio, and this chip
                answers the tags through it (docs/ap-radio-link.md).
    endchoice

    config ESL_COPROC_UART_NUM
        int "Radio coprocessor: UART"
        depends on ESL_RADIO_UART
        range 1 2
        default 1

    config ESL_COPROC_TX_GPIO
        int "Radio coprocessor: TX pin (to the radio's RX)"
        depends on ESL_RADIO_UART
        default 17

    config ESL_COPROC_RX_GPIO
        int "Radio coprocessor: RX pin (from the radio's TX)"
        depends on ESL_RADIO_UART
        default 18

    config ESL_SNIFFER_HOP_MS
        int "Sniffer: hop through channels 11-26, ms per channel (0 = stay on ESL_CHANNEL)"
        depends on ESL_RADIO_SNIFFER
        range 0 10000
        default 0
        help
            For finding a device whose channel is unknown, such as a stock
            SoluM remote. After a frame is heard the sniffer stays on that
            channel for 10 s before it hops on.

    config ESL_STUB_TAGS
        int "Simulated tags"
        depends on ESL_RADIO_STUB
        range 1 16
        default 3

    config ESL_STUB_INTERVAL_S
        int "Simulated poll interval (s)"
        depends on ESL_RADIO_STUB
        range 1 600
        default 10

endmenu
