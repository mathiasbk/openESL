# systemd unit for openesl-ap (docs/linux-ap.md). Install:
#   sudo install -m 755 openesl-ap /usr/local/bin/
#   sudo install -m 644 openesl-ap.conf /etc/openesl-ap.conf   (no token in it: see the file)
#   sudo install -m 644 openesl-ap.service /etc/systemd/system/
#   sudo systemctl enable --now openesl-ap
# It runs as its own unprivileged user (DynamicUser); port 80 comes from
# CAP_NET_BIND_SERVICE, the radio's serial or SPI device from the groups below.
[Unit]
Description=OpenESL access point
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/openesl-ap --config /etc/openesl-ap.conf --data /var/lib/openesl
Restart=on-failure
RestartSec=5
DynamicUser=yes
StateDirectory=openesl
# a serial radio (/dev/ttyACM*, /dev/ttyUSB*) is in dialout, an SPI one often in spi or gpio
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
