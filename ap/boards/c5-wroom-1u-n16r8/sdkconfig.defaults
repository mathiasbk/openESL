# ESP32-C5 with 16 MB flash and 8 MB quad PSRAM, such as the ESP32-C5-WROOM-1U-N16R8
# (external antenna) on the Waveshare ESP32-C5-WIFI6-KIT. The same 802.15.4 driver as
# the C6; WiFi can also use 5 GHz, which leaves 2.4 GHz to the tags.
# Built by CI but not yet tried on a board: status "experimental" in board.json.
CONFIG_IDF_TARGET="esp32c5"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/c5-wroom-1u-n16r8/partitions.csv"

# PSRAM: malloc puts blocks of 16 KB and more there (the tag table, the API's buffers,
# the layout files), and WiFi and lwIP may use it for their buffers. The AP code
# allocates everything big with malloc, so it needs no changes for this.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# With PSRAM the limits sdkconfig.defaults sets for the C6's RAM can go back up
CONFIG_ESL_MAX_TAGS=1000
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
