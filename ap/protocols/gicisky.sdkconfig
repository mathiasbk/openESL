# Gicisky Bluetooth tags with their maker's firmware (protocols.json "gicisky", docs/ble-tags.md):
# the BLE central in main/ble.c. NimBLE in the central and observer roles, one connection; the
# tag needs an ATT MTU of at least 247 for its 244-byte image chunks.
CONFIG_ESL_BLE=y
CONFIG_ESL_BLE_AUTO_ADD=y
CONFIG_ESL_BLE_ROUND_MS=5000
CONFIG_ESL_BLE_TAG_MAC=""
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
