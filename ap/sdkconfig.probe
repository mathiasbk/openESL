# Experiment: sniffer that answers a stock tag through join (E0/E1, D7/80+D8) and then
# answers AA with AD size FFFF, then F9 and FA (chunk index 1). Isolated AD left the
# tag on AA (probe12). F5 is the image path and is not sent.
# Build with:
#   idf.py -B build-probe -D SDKCONFIG=build-probe/sdkconfig -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.sniffer;sdkconfig.probe" build
CONFIG_ESL_SNIFF_PROBE_REPLY=y
# Stay on one channel (the AP channel): a stock tag sends its search frame on every channel 11-26 in each
# sweep, so one channel hears one frame per sweep and the reply can follow at once on that channel.
CONFIG_ESL_SNIFF_HOP_MS=0
CONFIG_ESL_SNIFF_TARGET="BB950702FF94BAC8"
