CONFIG_IDF_TARGET="esp32c6"

# WiFi and 802.15.4 share the 2.4 GHz radio
CONFIG_IEEE802154_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# HTTP API: room for the Authorization header and a wildcard route
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Log and serial API (ESL_SERIAL_API) on the built-in USB port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Task watchdog: the radio task and the serial API task are registered with it
# (and the idle task, so a task that never yields is caught too). After 10 s
# without a feed the AP restarts; GET /api/tags then shows "reset": "task_wdt"
# under "ap". The tag table and content are in NVS, so they survive it.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# 4 MB flash (ESP32-C6FH4): bigger NVS for tag content and layout files, and
# two app slots for OTA (partitions.csv). A new image must confirm itself
# after boot (esp_ota_mark_app_valid_cancel_rollback in app_main.c), or the
# bootloader goes back to the old one.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# RAM: the C6 runs WiFi, 802.15.4, the HTTP server and up to 256 tags in 512 KB,
# and the API needs one free block of up to 23 KB. WiFi keeps fewer receive
# buffers all the time (each 1.6 KB) and caps the ones it takes under load, and
# each TCP connection buffers at most two segments: the API's replies are small
# or streamed, so throughput is not what limits it. About 6 KB less in use at
# all times, and far lower peaks while a browser loads the dashboard.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
